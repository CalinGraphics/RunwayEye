# RunwayEye: copy to .env and adjust. Never commit .env.

# --- Video source ------------------------------------------------------------
# Camera index ("0" = first webcam), a file path (looped) or a stream URL
# (rtsp://..., or http://<phone-ip>:8080/video for a phone IP-camera app).
VIDEO_SOURCE=0
# Used automatically if VIDEO_SOURCE does not respond (record a clip of the mock-up!).
FALLBACK_VIDEO=data/videos/fallback.mp4
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
FRAME_WIDTH=960
CAMERA_ID=cam-01
CAMERA_NAME=Camera 1 · machetă

# --- YOLO --------------------------------------------------------------------
ENABLE_YOLO=true
YOLO_MODEL_PATH=models/best.pt
# Provisional pretrained COCO model, used only while models/best.pt is missing (downloaded once).
YOLO_FALLBACK_MODEL=models/yolo11n.pt
YOLO_CONF=0.35
YOLO_EVERY_N=2

# --- Change detection & persistence (pixels at FRAME_WIDTH) --------------------
REFERENCE_FRAMES=15
DIFF_THRESHOLD=30
MIN_AREA_PX=60
MAX_AREA_PX=6000
PERSIST_FRAMES=8
LARGE_PERSIST_FRAMES=30
GONE_FRAMES=20
UNKNOWN_CRITICAL_CM=15

# --- Runway (TO BE VERIFIED with the airport) --------------------------------
RUNWAY_NAME=09/27
RUNWAY_LENGTH_M=2500
RUNWAY_WIDTH_M=45
SECTORS_ALONG=6
SECTORS_ACROSS=3
# Physical size of the runway painted on the mock-up (cm), for object size; 0 = real runway.
MOCKUP_LENGTH_CM=100
MOCKUP_WIDTH_CM=60

# --- Data ----------------------------------------------------------------------
# true = only the local copy (SQLite + images in data/). Supabase is used only when
# ENABLE_SUPABASE=true AND USE_LOCAL_DATA=false AND URL + key are set.
USE_LOCAL_DATA=true
ENABLE_SUPABASE=false
SUPABASE_URL=
# Server-side secret key (service role). It stays on this laptop; never in the browser.
SUPABASE_KEY=
SUPABASE_BUCKET=fod-images

# --- Claude (bonus, off by default) ---------------------------------------------
ENABLE_CLAUDE=false
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- App -----------------------------------------------------------------------
# DEMO_MODE=false hides the tuning panel and technical error messages (for the pitch).
DEMO_MODE=true
# true = random fake detections every ~15 s (to build/show the dashboard without vision).
DEMO_FAKE_DETECTIONS=false
HOST=0.0.0.0
PORT=8000
# Key for phones and other laptops (it's inside the QR code). Empty = generated once in data/access_key.txt.
ACCESS_KEY=
