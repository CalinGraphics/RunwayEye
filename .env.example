# RunwayEye: copy to .env and adjust. Never commit .env.

# --- Video source ------------------------------------------------------------
# A clip (looped, like a live camera), a camera index ("0" = the laptop webcam) or a stream URL
# (rtsp://... surveillance camera). Can also be changed live on the "Sursa video" page.
# Phone with an IP-camera app: http://<phone-ip>:8080/video
VIDEO_SOURCE=data/videos/synthetic_demo.mp4
# Used automatically if VIDEO_SOURCE does not respond. synthetic_demo.mp4 is drawn by
# scripts/setup.py; for the pitch, record a clip of the mock-up and put its path here.
FALLBACK_VIDEO=data/videos/synthetic_demo.mp4
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
FRAME_WIDTH=960
CAMERA_ID=cam-01
CAMERA_NAME=Camera 1 · machetă

# --- YOLO --------------------------------------------------------------------
ENABLE_YOLO=true
YOLO_MODEL_PATH=backend/models/best.pt
# Provisional pretrained COCO model, used only while models/best.pt is missing (downloaded once).
YOLO_FALLBACK_MODEL=backend/models/yolo11n.pt
YOLO_CONF=0.35
YOLO_EVERY_N=2
# A YOLO detection with no change against the clean runway (markings, lights misread) needs this
# much confidence to raise an alert; seen by both YOLO and the change detector, YOLO_CONF is enough.
YOLO_ONLY_CONF=0.7
# Open-vocabulary model (birds, animals, tyre pieces, bags...), next to the FOD model above.
ENABLE_GENERAL_MODEL=true
GENERAL_MODEL_PATH=backend/models/general.pt
GENERAL_CONF=0.3
# The general model is ~4x slower than the FOD one: run it on every Nth YOLO pass.
GENERAL_EVERY_N=2

# --- Change detection & persistence (pixels at FRAME_WIDTH) --------------------
REFERENCE_FRAMES=15
DIFF_THRESHOLD=30
MIN_AREA_PX=60
MAX_AREA_PX=6000
PERSIST_FRAMES=8
LARGE_PERSIST_FRAMES=30
GONE_FRAMES=20
UNKNOWN_CRITICAL_CM=15

# --- Runway (TO BE VERIFIED with the airport) --------------------------------
RUNWAY_NAME=09/27
RUNWAY_LENGTH_M=2500
RUNWAY_WIDTH_M=45
SECTORS_ALONG=6
SECTORS_ACROSS=3
# Physical size of the runway painted on the mock-up (cm), for object size; 0 = real runway.
MOCKUP_LENGTH_CM=100
MOCKUP_WIDTH_CM=60

# --- Data ----------------------------------------------------------------------
# Supabase is the central database (all cameras, all laptops). Every incident is also written
# locally first (data/runwayeye.db), so alerts never wait for the internet; the queue is sent
# when the connection returns. Without URL + key the app simply runs local-only.
# New project: run supabase/schema.sql in the SQL Editor once.
ENABLE_SUPABASE=true
USE_LOCAL_DATA=false
SUPABASE_URL=
# The SECRET key (sb_secret_... or the legacy service_role key), not the publishable one:
# the tables have RLS without policies. It stays on this laptop; the browser never sees it.
SUPABASE_KEY=
SUPABASE_BUCKET=fod-images

# --- Claude (bonus, off by default) ---------------------------------------------
ENABLE_CLAUDE=false
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- App -----------------------------------------------------------------------
# DEMO_MODE=false hides the tuning panel and technical error messages (for the pitch).
DEMO_MODE=true
# true = random fake detections every ~15 s (to build/show the dashboard without vision).
DEMO_FAKE_DETECTIONS=false
HOST=0.0.0.0
PORT=8000
# Key for phones and other laptops (it's inside the QR code). Empty = generated once in data/access_key.txt.
ACCESS_KEY=
