# Secrets
.env

# Python
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Node (only needed to rebuild frontend/static/css/app.css)
node_modules/

# Data produced at runtime (incidents, images, calibration, demo clip, evaluation output)
data/

# Model weights: pretrained ones are downloaded; our backend/models/best.pt (FOD, ~5 MB) and
# backend/models/general.pt (open vocabulary) are committed, so a fresh clone detects right away.
*.pt
!backend/models/best.pt
!backend/models/general.pt
backend/models/cache/

# Training: datasets are downloaded, runs are produced locally
datasets/
runs/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
